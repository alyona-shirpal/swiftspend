# Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# API URL — baked into the web bundle at build time (Vite, not the Express API)
# Production default (this file is committed):
VITE_API_URL=https://swiftspend-api.vercel.app

# Local development override — create apps/web/.env.local (git-ignored):
#   VITE_API_URL=http://localhost:3000
# Vite loads .env.local after .env, so it wins when you run `npm run dev`.
# On Vercel, only .env is present unless you set VITE_API_URL in the dashboard.
